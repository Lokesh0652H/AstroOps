# Copy to .env and fill in real values. NEVER commit a real .env — the export
# policy excludes it from source archives.
MONGO_URL="mongodb://localhost:27017"
DB_NAME="app"
CORS_ORIGINS="*"
APP_URL="https://your-app.example.com"

# Optional export roots for GET /api/export/source (defaults shown).
# The endpoint never accepts arbitrary paths — only these two fixed roots.
# EXPORT_ROOT_ASTRAOPS=/app
# EXPORT_ROOT_WELTRIX=/app/weltrix-source
